# /etc/systemd/system/missedcallagent.service
#
# Install:
#   sudo cp deploy/missedcallagent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable missedcallagent
#   sudo systemctl start missedcallagent

[Unit]
Description=Missed Call Agent API
After=network.target

[Service]
Type=simple
User=ubuntu

WorkingDirectory=/home/ubuntu/missedcallagent-site/backend

# Set your production domain and a strong password for /api/leads
Environment="ALLOWED_ORIGINS=https://yourdomain.com"
Environment="LEADS_PASSWORD=changeme"

ExecStart=/home/ubuntu/missedcallagent-site/backend/.venv/bin/uvicorn \
    main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
